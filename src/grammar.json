{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "draft",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "header"
          },
          {
            "type": "SYMBOL",
            "name": "context"
          },
          {
            "type": "SYMBOL",
            "name": "sub_context"
          },
          {
            "type": "SYMBOL",
            "name": "markers"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "narration"
            },
            "named": true,
            "value": "paragraph"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "quotation"
            },
            "named": true,
            "value": "paragraph"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "dialog"
            },
            "named": true,
            "value": "paragraph"
          },
          {
            "type": "SYMBOL",
            "name": "asterix"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          }
        ]
      }
    },
    "header": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "prefix"
        },
        {
          "type": "SYMBOL",
          "name": "name"
        }
      ]
    },
    "prefix": {
      "type": "STRING",
      "value": "_"
    },
    "name": {
      "type": "PATTERN",
      "value": "[^\\s,\\n.~]+"
    },
    "comment": {
      "type": "PATTERN",
      "value": "[ \\t]+[^\\n]*\\n"
    },
    "context": {
      "type": "PATTERN",
      "value": "\\+[^\\n]*\\n"
    },
    "sub_context": {
      "type": "PATTERN",
      "value": "-[^\\n]*\\n"
    },
    "markers": {
      "type": "SEQ",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "marker"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "STRING",
                        "value": ","
                      },
                      {
                        "type": "CHOICE",
                        "members": [
                          {
                            "type": "STRING",
                            "value": " "
                          },
                          {
                            "type": "BLANK"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "SYMBOL",
                    "name": "marker"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "marker": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "SYMBOL",
          "name": "_namespace"
        },
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "name"
            },
            {
              "type": "SYMBOL",
              "name": "clear"
            }
          ]
        }
      ]
    },
    "_namespace": {
      "type": "PATTERN",
      "value": "[^\\s,\\n.]+"
    },
    "clear": {
      "type": "STRING",
      "value": "~"
    },
    "asterix": {
      "type": "PATTERN",
      "value": "\\*{1,3}\\n"
    },
    "narration": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "quotation": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "text"
                },
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_open_quote"
                  },
                  "named": true,
                  "value": "quote"
                }
              ]
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_open_quote"
              },
              "named": true,
              "value": "quote"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "text"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_open_quote"
                },
                "named": true,
                "value": "quote"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "dialog": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_open_speech"
                },
                "named": true,
                "value": "speech"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_open_text"
                },
                "named": true,
                "value": "text"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_end_speech"
              },
              "named": true,
              "value": "speech"
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_open_speech"
                  },
                  "named": true,
                  "value": "speech"
                },
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_end_text"
                  },
                  "named": true,
                  "value": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    "_open_quote": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "„"
        },
        {
          "type": "PATTERN",
          "value": "[^„”\\n]+"
        },
        {
          "type": "STRING",
          "value": "”"
        }
      ]
    },
    "text": {
      "type": "PATTERN",
      "value": "[^@\\+\\-—_\\t„”\\n][^„”\\n]*"
    },
    "_open_speech": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "—"
        },
        {
          "type": "PATTERN",
          "value": "[^„”—\\n]+"
        },
        {
          "type": "STRING",
          "value": "—"
        }
      ]
    },
    "_end_speech": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "—"
        },
        {
          "type": "PATTERN",
          "value": "[^„”—\\n]+"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "_open_text": {
      "type": "PATTERN",
      "value": "[^\\t„”—\\n]+"
    },
    "_end_text": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^\\t„”—\\n]+"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "_eol": {
      "type": "STRING",
      "value": "\n"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}