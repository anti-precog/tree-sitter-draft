{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "draft",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "header"
          },
          {
            "type": "SYMBOL",
            "name": "main_context"
          },
          {
            "type": "SYMBOL",
            "name": "head_context"
          },
          {
            "type": "SYMBOL",
            "name": "foot_context"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "narration"
            },
            "named": true,
            "value": "paragraph"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "quotation"
            },
            "named": true,
            "value": "paragraph"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "dialog"
            },
            "named": true,
            "value": "paragraph"
          },
          {
            "type": "SYMBOL",
            "name": "asterix"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          }
        ]
      }
    },
    "header": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "tag"
        },
        {
          "type": "SYMBOL",
          "name": "name"
        }
      ]
    },
    "tag": {
      "type": "STRING",
      "value": "#"
    },
    "name": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^ \\t\\n][^\\n]*"
      }
    },
    "comment": {
      "type": "PATTERN",
      "value": "[ \\t]+[^\\n]*\\n"
    },
    "head_context": {
      "type": "PATTERN",
      "value": ">[^>\\n][^\\n]*\\n"
    },
    "main_context": {
      "type": "PATTERN",
      "value": ">{2,}[^\\n]*\\n"
    },
    "foot_context": {
      "type": "PATTERN",
      "value": "<+[^\\n]*\\n"
    },
    "asterix": {
      "type": "PATTERN",
      "value": "\\*{1,3}\\n"
    },
    "narration": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "quotation": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "text"
                },
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_open_quote"
                  },
                  "named": true,
                  "value": "quote"
                }
              ]
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_open_quote"
              },
              "named": true,
              "value": "quote"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "text"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_open_quote"
                },
                "named": true,
                "value": "quote"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "dialog": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_open_speech"
                },
                "named": true,
                "value": "speech"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_open_text"
                },
                "named": true,
                "value": "text"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_end_speech"
              },
              "named": true,
              "value": "speech"
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_open_speech"
                  },
                  "named": true,
                  "value": "speech"
                },
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_end_text"
                  },
                  "named": true,
                  "value": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    "_open_quote": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "„"
        },
        {
          "type": "PATTERN",
          "value": "[^„”\\n]+"
        },
        {
          "type": "STRING",
          "value": "”"
        }
      ]
    },
    "text": {
      "type": "PATTERN",
      "value": "[^<>—#\\t„”\\n][^„”\\n]*"
    },
    "_open_speech": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "—"
        },
        {
          "type": "PATTERN",
          "value": "[^„”—\\n]+"
        },
        {
          "type": "STRING",
          "value": "—"
        }
      ]
    },
    "_end_speech": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "—"
        },
        {
          "type": "PATTERN",
          "value": "[^„”—\\n]+"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "_open_text": {
      "type": "PATTERN",
      "value": "[^\\t„”—\\n]+"
    },
    "_end_text": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^\\t„”—\\n]+"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "_eol": {
      "type": "STRING",
      "value": "\n"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}