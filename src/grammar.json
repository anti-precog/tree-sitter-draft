{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "draft",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "section"
          },
          {
            "type": "SYMBOL",
            "name": "group"
          },
          {
            "type": "SYMBOL",
            "name": "narration"
          },
          {
            "type": "SYMBOL",
            "name": "quotation"
          },
          {
            "type": "SYMBOL",
            "name": "dialog"
          },
          {
            "type": "SYMBOL",
            "name": "asterix"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          }
        ]
      }
    },
    "section": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "title"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "group"
                },
                {
                  "type": "SYMBOL",
                  "name": "narration"
                },
                {
                  "type": "SYMBOL",
                  "name": "quotation"
                },
                {
                  "type": "SYMBOL",
                  "name": "dialog"
                },
                {
                  "type": "SYMBOL",
                  "name": "asterix"
                },
                {
                  "type": "SYMBOL",
                  "name": "comment"
                }
              ]
            }
          }
        ]
      }
    },
    "title": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "tag"
        },
        {
          "type": "PATTERN",
          "value": "[^\\n]*"
        },
        {
          "type": "PATTERN",
          "value": "\\n"
        }
      ]
    },
    "tag": {
      "type": "PATTERN",
      "value": "[#]+"
    },
    "group": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "header"
              },
              {
                "type": "SYMBOL",
                "name": "_eol"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "narration"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "quotation"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "comment"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "dialog"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "asterix"
                    }
                  ]
                }
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "footer"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "_eol"
                      }
                    ]
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "narration"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "quotation"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "comment"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "dialog"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "asterix"
                    }
                  ]
                }
              },
              {
                "type": "SYMBOL",
                "name": "footer"
              },
              {
                "type": "SYMBOL",
                "name": "_eol"
              }
            ]
          }
        ]
      }
    },
    "header": {
      "type": "PATTERN",
      "value": ">[^\\n]*"
    },
    "footer": {
      "type": "PATTERN",
      "value": "<[^\\n]*"
    },
    "comment": {
      "type": "PATTERN",
      "value": "[ \\t]+[^\\n]*\\n"
    },
    "asterix": {
      "type": "PATTERN",
      "value": "\\*{1,3}\\n"
    },
    "narration": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "quotation": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "text"
                },
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_open_quote"
                  },
                  "named": true,
                  "value": "quote"
                }
              ]
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_open_quote"
              },
              "named": true,
              "value": "quote"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "text"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_open_quote"
                },
                "named": true,
                "value": "quote"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "dialog": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_open_speech"
                },
                "named": true,
                "value": "speech"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_open_text"
                },
                "named": true,
                "value": "text"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_end_speech"
              },
              "named": true,
              "value": "speech"
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_open_speech"
                  },
                  "named": true,
                  "value": "speech"
                },
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_end_text"
                  },
                  "named": true,
                  "value": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    "_open_quote": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "„"
        },
        {
          "type": "PATTERN",
          "value": "[^„”\\n]+"
        },
        {
          "type": "STRING",
          "value": "”"
        }
      ]
    },
    "text": {
      "type": "PATTERN",
      "value": "[^—#\\t>„”\\n][^„”\\n]*"
    },
    "_open_speech": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "—"
        },
        {
          "type": "PATTERN",
          "value": "[^„”—\\n]+"
        },
        {
          "type": "STRING",
          "value": "—"
        }
      ]
    },
    "_end_speech": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "—"
        },
        {
          "type": "PATTERN",
          "value": "[^„”—\\n]+"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "_open_text": {
      "type": "PATTERN",
      "value": "[^\\t>„”—\\n]+"
    },
    "_end_text": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^\\t>„”—\\n]+"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "_eol": {
      "type": "STRING",
      "value": "\n"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    {
      "type": "PATTERN",
      "value": "\\n"
    }
  ],
  "conflicts": [
    [
      "document",
      "group"
    ],
    [
      "section",
      "group"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}